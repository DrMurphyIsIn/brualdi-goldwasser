theorem rateCellKap_22 : RateCellKap 22 (357/1000000 : ℝ) (0 : ℝ) (1/200 : ℝ) (1/200 : ℝ) (1/500 : ℝ) := by
  intro cs hlen hcap hna
  obtain ⟨K, hK⟩ : ∃ K, cs.length = K := ⟨_, rfl⟩
  have hK0 : 1 ≤ K := by
    rcases cs with _ | ⟨a, t⟩
    · exact absurd (Or.inr ⟨0, rfl⟩) hna
    · simp at hK; omega
  have hKD : K ≤ 21 := by omega
  interval_cases K
